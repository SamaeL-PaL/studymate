# Contoh nama variabel lingkungan (environment variable) untuk StudyMate.
# Cara pakai: salin file ini menjadi .env.local, lalu isi nilainya.
# File .env.local TIDAK boleh di-commit ke GitHub (sudah diabaikan oleh .gitignore).

# ===== Konfigurasi LLM untuk fitur chat (/chat) =====
# PENTING: ketiga variabel ini sengaja TANPA awalan NEXT_PUBLIC_,
# jadi nilainya tidak pernah ikut terkirim ke browser.

# Alamat server LLM yang formatnya kompatibel dengan OpenAI.
# Tergantung penyedia, alamatnya kadang perlu diakhiri "/v1" dan kadang tidak.
# Contoh: https://api.openai.com/v1
LLM_BASE_URL=

# Kunci rahasia dari penyedia LLM. Jangan bagikan ke siapa pun.
LLM_API_KEY=

# Nama model yang ingin dipakai. Contoh: gpt-4o-mini
LLM_MODEL=