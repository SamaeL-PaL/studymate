# Contoh nama variabel lingkungan untuk StudyMate.
# Cara pakai: salin file ini menjadi .env.local, lalu isi nilainya.
# File .env.local TIDAK boleh di-commit ke GitHub (sudah diabaikan oleh .gitignore).

# API key untuk fitur AI (isi nanti saat fitur tanya dokumen mulai dibuat).
AI_API_KEY=

# Alamat model AI yang dipakai (opsional).
AI_BASE_URL=